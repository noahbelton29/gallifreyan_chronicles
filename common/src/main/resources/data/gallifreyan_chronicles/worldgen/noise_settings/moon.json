{
  "default_block": "gallifreyan_chronicles:lunar_regolith",
  "default_fluid": "minecraft:air",
  "disable_mob_generation": false,
  "legacy_random_source": false,
  "material_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "false_at_and_above": {
            "above_bottom": 5
          },
          "random_name": "gallifreyan_chronicles:bedrock_floor",
          "true_at_and_below": {
            "above_bottom": 0
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "minecraft:bedrock"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:not",
          "invert": {
            "type": "minecraft:y_above",
            "add_stone_depth": false,
            "anchor": {
              "absolute": 0
            },
            "surface_depth_multiplier": 0
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": "gallifreyan_chronicles:moonslate"
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:above_preliminary_surface"
        },
        "then_run": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:biome",
                "biome_is": "gallifreyan_chronicles:moon"
              },
              "then_run": {
                "type": "minecraft:sequence",
                "sequence": [
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:stone_depth",
                      "add_surface_depth": false,
                      "offset": 0,
                      "secondary_depth_range": 0,
                      "surface_type": "floor"
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "gallifreyan_chronicles:moon_dust"
                    }
                  },
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:stone_depth",
                      "add_surface_depth": false,
                      "offset": 4,
                      "secondary_depth_range": 0,
                      "surface_type": "floor"
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "gallifreyan_chronicles:lunar_regolith"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "noise": {
    "height": 384,
    "min_y": -64
  },
  "noise_router": {
    "chunk_surface_level": "minecraft:overworld/chunk_surface_level",
    "continents": "minecraft:overworld/continents",
    "depth": "minecraft:overworld/depth",
    "erosion": "minecraft:overworld/erosion",
    "final_density": "minecraft:overworld/final_density",
    "ridges": "minecraft:overworld/ridges",
    "temperature": "minecraft:overworld/temperature",
    "vegetation": "minecraft:overworld/vegetation"
  },
  "sea_level": 0,
  "spawn_target": []
}