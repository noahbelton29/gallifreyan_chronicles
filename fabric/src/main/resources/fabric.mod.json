{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "NoahTNT2009"
    ],
    "contributors": [
        "Fredbear1983"
    ],
    "contact": {
        "homepage": "https://nbforge.dev/",
        "sources": "https://github.com/noahbelton29/gallifreyan_chronicles"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.noahtnt2009.gallifreyan_chronicles.GallifreyanChroniclesFabric"
        ],
        "client": [
            "com.noahtnt2009.gallifreyan_chronicles.GallifreyanChroniclesFabricClient"
        ],
        "modmenu": [
            "com.noahtnt2009.gallifreyan_chronicles.compat.GCModMenuIntegration"
        ],
        "jade": ["com.noahtnt2009.gallifreyan_chronicles.compat.GCJadePlugin"]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}",
        "geckolib": ">=5.5.7"
    },
    "suggests": {
        "another-mod": "*"
    },
    "accessWidener": "${mod_id}.accesswidener"
}
